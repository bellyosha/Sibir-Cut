        def closed():self._wizard=None;w.destroy()
        w.protocol('WM_DELETE_WINDOW',closed);render()

    def calibrate(self):
        w=tk.Toplevel(self);w.title('Мастер калибровки A1 + UMTS')
        screen_h=max(560,self.winfo_screenheight());screen_w=max(760,self.winfo_screenwidth())
        width=min(800,max(640,int(screen_w*0.68)));height=min(620,max(480,int(screen_h*0.72)))
        w.geometry(f'{width}x{height}+20+20');w.minsize(600,450);w.transient(self);w.grab_set()

        p0=self.project.printer;tool_key=p0.tool_key_for_mode(self.project.material.mode);tool_name='ручки' if tool_key=='pen' else 'ножа'
        cur=p0.get_tool_calibration(tool_key)
        vx=tk.DoubleVar(value=cur['offset_x'])
        vy=tk.DoubleVar(value=cur['offset_y'])
        vw=tk.DoubleVar(value=cur['z'])
        vs=tk.DoubleVar(value=cur['safe_z'])
        ok=tk.BooleanVar(master=w,value=False)

        def apply():
            if not ok.get():
                messagebox.showwarning('Калибровка','Поставьте галочку подтверждения: значения должны быть измерены на вашем модуле.',parent=w);return
            try:
                safe_z=float(vs.get());contact_z=float(vw.get())
                if safe_z<=contact_z:
                    if not messagebox.askyesno('Проверка Z','Безопасная Z не выше рабочей Z. Вы уверены, что для вашей механики это правильно?',parent=w):
                        return
                p=self.project.printer
                p.set_tool_calibration(tool_key,offset_x=float(vx.get()),offset_y=float(vy.get()),z=contact_z,safe_z=safe_z,calibrated=True)
                p.apply_tool_calibration(self.project.material.mode);p.z_calibration_version=2
                if self.project.material.mode!='Рисование':self.project.material.work_z=p.work_z
                else:self.project.material.work_z=p.work_z
                self.project.material.safe_z=max(float(self.project.material.safe_z),p.safe_z)
                w.destroy();self.refresh_all()
            except Exception as exc:
                messagebox.showerror('Калибровка',str(exc),parent=w)

        # Top action bar is intentionally first and always visible, even if
        # Windows DPI scaling clips the lower edge of the window.
        toolbar=ttk.Frame(w,padding=(10,8));toolbar.pack(side='top',fill='x')
        ttk.Label(toolbar,text=f'Калибровка A1 + UMTS — {tool_name}',style='Title.TLabel').pack(side='left')
        ttk.Button(toolbar,text='Отмена',command=w.destroy).pack(side='right')
        ttk.Button(toolbar,text='Сохранить калибровку',style='Danger.TButton',command=apply).pack(side='right',padx=(0,8))

        values=ttk.LabelFrame(w,text='Измеренные значения',padding=10)
        values.pack(side='bottom',fill='x',padx=10,pady=(4,4))
        values.grid_columnconfigure(1,weight=1)
        z_label='Z первого касания ручки, без нажима' if tool_key=='pen' else 'Рабочая Z ножа'
        for row,(lab,var) in enumerate([('Offset X кончика от сопла, мм',vx),('Offset Y кончика от сопла, мм',vy),(z_label,vw),('Минимальная безопасная Z',vs)]):
            ttk.Label(values,text=lab).grid(row=row,column=0,sticky='w',padx=(0,10),pady=3)
            ttk.Entry(values,textvariable=var).grid(row=row,column=1,sticky='ew',pady=3)

        confirm=ttk.Frame(w,padding=(10,0,10,4));confirm.pack(side='bottom',fill='x')
        ttk.Checkbutton(
            confirm,
            text='Я измерил Z первого касания БЕЗ нажима и безопасную Z',
            variable=ok
        ).pack(side='left',anchor='w')

        body=ttk.Frame(w,padding=(10,4,10,4));body.pack(side='top',fill='both',expand=True)
        body.grid_columnconfigure(0,weight=1);body.grid_rowconfigure(0,weight=1)
        txt=tk.Text(body,wrap='word',font=('Segoe UI',10),height=8)
        sb=ttk.Scrollbar(body,orient='vertical',command=txt.yview);txt.configure(yscrollcommand=sb.set)
        txt.grid(row=0,column=0,sticky='nsew');sb.grid(row=0,column=1,sticky='ns')
        txt.insert('1.0',f'''Мастер калибровки Sibir Cut — профиль {tool_name}

Лучше выполнять XY/Z калибровку из окна «LAN управление»: там Sibir Cut сам вычисляет Offset по общей метке сопла и инструмента.

Ручной ввод:
1. Снимите UMTS и выполните Home.
2. Измерьте физическое смещение кончика {tool_name} относительно сопла.
3. Offset X/Y хранится именно как: КОНЧИК = СОПЛО + OFFSET.
4. Найдите безопасную Z.
5. Для ножа укажите рабочую Z; для ручки — первое касание без нажима.
6. Сохраните профиль. При выборе «Резка» или «Рисование» нужный профиль применяется автоматически.


Горячие клавиши:
Ctrl+Enter — сохранить калибровку
Esc — отмена

Не копируйте чужие значения Z: они зависят от конкретного UMTS, установки инструмента, материала и коврика.
''');txt.config(state='disabled')

        w.bind('<Escape>',lambda e:w.destroy())
        w.bind('<Control-Return>',lambda e:apply())
    def export(self,show_message=True):
        try:
            self.sync_material();self.apply_active_tool_calibration();paths=prepare_paths(self.project.objects,self.project.material)
            if not paths:raise GCodeError('Нет траекторий для экспорта')
            info=analyze_path_bounds(paths,self.project.printer)
            if info['outside_physical'] or info['outside_safe']:
                x0,y0,x1,y1=info['tool_bounds'];nx0,ny0,nx1,ny1=info.get('nozzle_bounds',(x0,y0,x1,y1));l,b,r,t=self.project.printer.safe_bounds
                messagebox.showwarning(
                    'Траектория выходит за границы',
                    f'Экспорт остановлен.\n\nКончики ножа/ручки:\nX {x0:.2f}…{x1:.2f} мм\nY {y0:.2f}…{y1:.2f} мм\n\nПоложение сопла после компенсации Offset:\nX {nx0:.2f}…{nx1:.2f} мм\nY {ny0:.2f}…{ny1:.2f} мм\n\nБезопасная область инструмента:\nX {l:.2f}…{r:.2f} мм\nY {b:.2f}…{t:.2f} мм\n\nПереместите или уменьшите объект.',
                    parent=self
                )
                return None
            g,stats=generate_gcode(paths,self.project.printer,self.project.material,air_test=False)
            f=filedialog.asksaveasfilename(defaultextension='.gcode',filetypes=[('A1 direct G-code','*.gcode')])
            if not f:return None
            orca_preview=None;raw_gcode=f
            Path(f).write_text(g,encoding='utf-8')
            root=str(Path(f).with_suffix(''))
            orca_preview=root+'_ORCA_PREVIEW.3mf'
            build_orca_preview_3mf(orca_preview,paths)
            report=Path(f+'.report.json');report.write_text(json.dumps({'material':self.project.material.to_dict(),'printer':self.project.printer.to_dict(),'cut_length_mm':stats.cut_length_mm,'travel_length_mm':stats.travel_length_mm,'estimated_seconds':stats.estimated_seconds,'bounds':stats.bounds,'passes':stats.passes,'orca_preview':orca_preview,'raw_gcode':raw_gcode},ensure_ascii=False,indent=2),encoding='utf-8')
            self.last_export_path=f
            if show_message:
                kind='задание'
                extra=''
                if orca_preview:
                    extra=f'\n\nДля A1: {f}\nДля просмотра формы в Orca: {orca_preview}'
                messagebox.showinfo('Экспорт',f'Готово: {kind}.{extra}\n\nВАЖНО: рабочий .gcode запускайте прямо с карты памяти на экране A1. Не открывайте его в Orca и не нарезайте заново. *_ORCA_PREVIEW.3mf — только визуальный просмотр.')
            return f
        except Exception as e:
            messagebox.showerror('Экспорт заблокирован',str(e));return None

    def export_and_send(self):
        path=self.export(show_message=False)
        if path:
            upload_path_via_lan(self,path,parent=self)

def calibration_gui_self_test():
    """Smoke-test the full 0.3 main shell without opening network dialogs."""
    app=None
    try:
        app=App()
        app._auto_connect_started=True
        app.update_idletasks()
        if not hasattr(app,'printer_chip') or not hasattr(app,'slice_btn') or not hasattr(app,'send_btn'):
            raise RuntimeError('Slicer shell controls were not created')
        app.set_mode_quick('Рисование')
        if app.mode.get()!='Рисование':
            raise RuntimeError('Main mode switch failed')
        app.set_mode_quick('Резка')
        if app.mode.get()!='Резка':
            raise RuntimeError('Main mode switch failed')
        app.project.objects=[SceneObject('transform-smoke',[[(20.0,20.0),(50.0,20.0),(45.0,40.0),(20.0,20.0)]])]
        app.refresh_all();app.listbox.selection_set(0);app.listbox.activate(0);app.load_obj_fields();app.update_idletasks()
        handles=app._transform_handles(0)
        if not handles or 'rotate' not in handles or 'scale' not in handles:
            raise RuntimeError('Live transform handles were not created')
    finally:
        if app is not None:
            try:app.destroy()
            except Exception:pass

def main():
    App().mainloop()
if __name__=='__main__':main()
