        bottom=tk.Frame(self,bg='#ffffff',height=34);bottom.pack(fill='x');bottom.pack_propagate(False)
        self.status=tk.Label(bottom,text='',bg='#ffffff',fg='#475569',font=('Segoe UI',9));self.status.pack(side='left',padx=14)
        self.warn=tk.Label(bottom,text='',bg='#ffffff',fg='#b45309',font=('Segoe UI',9,'bold'));self.warn.pack(side='right',padx=14)

    def set_printer_status(self,text,kind='idle'):
        self._printer_status_value=str(text);self._printer_status_kind=str(kind)
        colors={
            'ok':('#dcfce7','#166534','#bbf7d0'),
            'warn':('#fef3c7','#92400e','#fde68a'),
            'bad':('#fee2e2','#991b1b','#fecaca'),
            'idle':('#e2e8f0','#475569','#cbd5e1'),
        }
        bg,fg,hover=colors.get(kind,colors['idle'])
        if hasattr(self,'printer_chip'):
            label=str(text)
            if len(label)>35:label=label[:32]+'…'
            self.printer_chip.config(text=label,bg=bg,fg=fg,hover=hover)

    def _poll_printer_status(self):
        c=getattr(self,'_lan_client',None)
        if c is not None:
            try:
                if c.connected:
                    st=c.status_summary();state=str(st.get('gcode_state') or '—')
                    self.set_printer_status(f'A1 • {c.host} • {state}','ok')
                elif self._printer_status_kind=='ok':
                    self.set_printer_status(f'A1 • {c.host} • нет связи','bad')
            except Exception:pass
        try:self.after(1500,self._poll_printer_status)
        except Exception:pass

    def set_mode_quick(self,mode):
        self.mode.set(mode);self.project.material.mode=mode
        self.apply_job_settings();self._refresh_mode_buttons();self.update_main_summary()

    def toggle_job_mirror(self):
        self.project.material.mirror_x=bool(self.mirror_job.get())
        self._rebuild_prepared();self.draw();self.update_status();self.update_main_summary()

    def _refresh_mode_buttons(self):
        if not hasattr(self,'cut_mode_btn'):return
        cutting=self.mode.get()!='Рисование'
        self.cut_mode_btn.config(bg='#0f766e' if cutting else '#e2e8f0',fg='white' if cutting else '#475569',hover='#115e59' if cutting else '#cbd5e1')
        self.draw_mode_btn.config(bg='#7c3aed' if not cutting else '#e2e8f0',fg='white' if not cutting else '#475569',hover='#6d28d9' if not cutting else '#cbd5e1')

    def update_main_summary(self):
        if not hasattr(self,'main_summary'):return
        m=self.project.material
        typ='Рисование' if m.mode=='Рисование' else 'Резка'
        extra=(f"Штриховка {m.fill_spacing:.2f} мм • {m.fill_angle:.0f}°" if m.mode=='Рисование' else f"{m.passes} проход(а) • {m.work_speed:.0f} мм/с")
        orientation='Зеркально / наизнанку' if bool(getattr(m,'mirror_x',False)) else 'Обычная ориентация'
        self.main_summary.config(text=f'{typ}\nПрофиль: {m.name}\n{extra}\n{orientation}')

    def _close_app(self):
        c=getattr(self,'_lan_client',None)
        if c is not None:
            try:c.close()
            except Exception:pass
        self.destroy()

    def current_index(self):
        s=self.listbox.curselection();return s[0] if s else None
    def load_obj_fields(self):
        i=self.current_index();
        if i is None:return
        o=self.project.objects[i]
        for k in ('x','y','scale','rotation'):self.vars[k].set(getattr(o,'rotation_deg' if k=='rotation' else k))
        try:self.draw()
        except Exception:pass
    def checkpoint(self):
        self.history.append(copy.deepcopy(self.project));self.history=self.history[-50:];self.future.clear()
    def undo(self):
        if not self.history:return
        self.future.append(copy.deepcopy(self.project));self.project=self.history.pop();self.refresh_all()
    def redo(self):
        if not self.future:return
        self.history.append(copy.deepcopy(self.project));self.project=self.future.pop();self.refresh_all()
    def apply_transform(self):
        i=self.current_index();
        if i is None:return
        self.checkpoint();o=self.project.objects[i];o.x=self.vars['x'].get();o.y=self.vars['y'].get();o.scale=max(0.001,self.vars['scale'].get());o.rotation_deg=self.vars['rotation'].get();self.refresh_all()
    def mirror(self,ax):
        i=self.current_index();
        if i is None:return
        self.checkpoint();o=self.project.objects[i];setattr(o,'mirror_'+ax,not getattr(o,'mirror_'+ax));self.refresh_all()
    def duplicate(self):
        i=self.current_index();
        if i is None:return
        self.checkpoint();o=self.project.objects[i];d=SceneObject.from_dict(o.to_dict());d.name+=' копия';d.x+=5;d.y+=5;self.project.objects.append(d);self.refresh_all()
    def duplicate_many(self):
        i=self.current_index()
        if i is None:return
        n=simpledialog.askinteger('Дублирование','Сколько копий создать?',initialvalue=2,minvalue=1,maxvalue=100,parent=self)
        if not n:return
        self.checkpoint();base=self.project.objects[i]
        for k in range(n):
            d=SceneObject.from_dict(base.to_dict());d.name=f'{base.name} копия {k+1}';d.x+=(k+1)*5;d.y+=(k+1)*5;self.project.objects.append(d)
        self.refresh_all()
    def align(self,mode):
        i=self.current_index()
        if i is None:return
        self.checkpoint();o=self.project.objects[i]
        from .geometry import transformed_paths
        ps=transformed_paths(o);x0,y0,x1,y1=bbox(ps);p=self.project.printer
        l,b,r,t=p.safe_bounds
        if mode=='center':o.x+=(l+r)/2-(x0+x1)/2;o.y+=(b+t)/2-(y0+y1)/2
        elif mode=='left':o.x+=l-x0
        self.refresh_all()

    def delete(self):
        i=self.current_index();
        if i is not None:self.checkpoint();self.project.objects.pop(i);self.refresh_all()
    def _run_background(self, title, fn, on_success):
        if self._busy:
            messagebox.showinfo('Sibir Cut','Сейчас уже выполняется обработка. Дождитесь её завершения.',parent=self)
            return
        self._busy=True
        w=tk.Toplevel(self);self._busy_win=w;w.title(title);w.geometry('430x130');w.transient(self);w.resizable(False,False)
        ttk.Label(w,text=title,style='Title.TLabel').pack(anchor='w',padx=16,pady=(16,6))
        ttk.Label(w,text='Окно можно перемещать — интерфейс не должен зависать.').pack(anchor='w',padx=16)
        bar=ttk.Progressbar(w,mode='indeterminate');bar.pack(fill='x',padx=16,pady=14);bar.start(12)
        w.protocol('WM_DELETE_WINDOW',lambda:None)

        results=queue.Queue(maxsize=1);started=time.monotonic();timed_out={'value':False}
        def worker():
            try:results.put((fn(),None))
            except Exception as exc:results.put((None,exc))
        def poll():
            try:result,error=results.get_nowait()
            except queue.Empty:
                elapsed=time.monotonic()-started
                if elapsed>45:
                    timed_out['value']=True;self._busy=False;self._busy_win=None
                    try:bar.stop();w.destroy()
                    except Exception:pass
                    messagebox.showerror(title,'Обработка превысила 45 секунд и остановлена для интерфейса. Закройте приложение и пришлите проблемный файл — такая операция не должна длиться так долго.',parent=self)
                    return
                self.after(50,poll);return
            self._busy=False;self._busy_win=None
            try:bar.stop();w.destroy()
            except Exception:pass
            if error is not None:
                messagebox.showerror(title,str(error),parent=self)
                return
            try:on_success(result)
            except Exception as exc:
                messagebox.showerror(title,str(exc),parent=self)
        threading.Thread(target=worker,daemon=True).start()
        self.after(50,poll)

    def do_import(self):
        f=filedialog.askopenfilename(filetypes=[('Поддерживаемые','*.svg *.dxf *.png *.jpg *.jpeg *.bmp *.webp'),('Все файлы','*.*')])
        if not f:return
        try:
            detected_kind=detect_import_kind(f)
        except Exception as exc:
            messagebox.showerror('Импорт',str(exc),parent=self);return
        opts={};is_raster=detected_kind=='raster'
        if is_raster:
            th=simpledialog.askinteger('Векторизация','Порог 0–255:',initialvalue=128,minvalue=0,maxvalue=255,parent=self)
            if th is None:return
            sm=simpledialog.askfloat('Векторизация','Сглаживание (0–5):',initialvalue=1.0,minvalue=0,maxvalue=5,parent=self)
            if sm is None:return
            inv=messagebox.askyesno('Векторизация','Инвертировать изображение?',parent=self)
