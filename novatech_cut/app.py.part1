        self.drawing_style=tk.StringVar();self.fill_spacing=tk.DoubleVar();self.fill_angle=tk.DoubleVar();self.fill_crosshatch=tk.BooleanVar();self.fill_inset=tk.DoubleVar();self.pen_press=tk.DoubleVar();self.pen_lift=tk.DoubleVar();self.mirror_job=tk.BooleanVar(value=False)

