            # 0.3.0: central-line extraction was removed from the normal import
            # workflow. Raster input is always treated as filled geometry/contours.
            opts={'threshold':th,'external_only':False,'smoothing':sm,'invert':inv,'centerline':False}

        def imported(paths):
            if not paths:
                raise ValueError('Контуры не найдены')
            if is_raster and not self.preview_paths_modal(paths):
                return
            self.checkpoint();x0,y0,x1,y1=bbox(paths)
            l,b,r,t=self.project.printer.safe_bounds;ww=max(0.001,x1-x0);hh=max(0.001,y1-y0)
            fit=max(0.001,min(1.0,(r-l-10.0)/ww,(t-b-10.0)/hh))
            o=SceneObject(Path(f).name,paths,x=(l+5)-x0*fit,y=(b+5)-y0*fit,scale=fit,source=f)
            self.project.objects.append(o)
            def prepared(paths2):
                self.prepared_paths=paths2;self.prepare_error=None
                self.listbox.delete(0,'end');[self.listbox.insert('end',obj.name) for obj in self.project.objects]
                self.refresh_fields();self.draw();self.update_status()
            self._run_background('Подготовка траектории…',lambda:prepare_paths(self.project.objects,self.project.material),prepared)

        self._run_background('Преобразование изображения…',lambda:import_paths(f,**opts),imported)
    def preview_paths_modal(self, paths):
        w=tk.Toplevel(self);w.title('Предпросмотр векторизации');w.geometry('760x620');w.transient(self);w.grab_set();result={'ok':False}
        c=tk.Canvas(w,bg='white',highlightthickness=1,highlightbackground='#cbd5e1');c.pack(fill='both',expand=True,padx=10,pady=10)
        x0,y0,x1,y1=bbox(paths);ww=max(1,x1-x0);hh=max(1,y1-y0)
        def redraw(e=None):
            c.delete('all');W=max(100,c.winfo_width());H=max(100,c.winfo_height());z=min((W-40)/ww,(H-40)/hh)
            shown=paths[:1200]
            for path in shown:
                xy=[];step=max(1,len(path)//700)
                sample=path[::step]
                if path and sample[-1]!=path[-1]:sample=sample+[path[-1]]
                for x,y in sample:xy.extend((20+(x-x0)*z,20+(y-y0)*z))
                if len(xy)>=4:c.create_line(*xy,fill='#dc2626',width=2)
            suffix='' if len(shown)==len(paths) else f'  (на экране первые {len(shown)})'
            c.create_text(12,8,anchor='nw',text=f'Контуров: {len(paths)}{suffix}  Размер: {ww:.1f} × {hh:.1f} мм',fill='#334155')
        c.bind('<Configure>',redraw)
        bar=ttk.Frame(w,padding=10);bar.pack(fill='x')
        def accept():result['ok']=True;w.destroy()
        ttk.Button(bar,text='Отмена',command=w.destroy).pack(side='right',padx=4);ttk.Button(bar,text='Использовать результат',command=accept).pack(side='right',padx=4)
        self.wait_window(w);return result['ok']

    def select_material(self):
        name=self.material_var.get();m=next((x for x in DEFAULT_MATERIALS if x.name==name),None)
        if m:
            self.project.material=MaterialProfile.from_dict(m.to_dict());self.apply_active_tool_calibration();self.refresh_all()
    def apply_job_settings(self):
        try:
            self.sync_material();self.apply_active_tool_calibration();self.refresh_all()
        except Exception as exc:
            messagebox.showerror('Параметры',str(exc),parent=self)
    def on_mode_changed(self):
        self.apply_job_settings()
    def sync_material(self):
        m=self.project.material;m.mode=self.mode.get();m.passes=max(1,self.passes.get());m.work_speed=max(0.1,self.work_speed.get());m.travel_speed=max(0.1,self.travel_speed.get());m.work_z=self.work_z.get();m.safe_z=self.safe_z.get();m.blade_offset=max(0,self.blade_offset.get());m.overcut=max(0,self.overcut.get())
        m.drawing_style=self.drawing_style.get() or 'Контур + заливка';m.fill_spacing=max(0.1,self.fill_spacing.get());m.fill_angle=self.fill_angle.get();m.fill_crosshatch=bool(self.fill_crosshatch.get());m.fill_inset=max(0.0,self.fill_inset.get());m.drawing_press_depth=max(0.0,self.pen_press.get());m.drawing_lift_height=max(0.0,self.pen_lift.get());m.mirror_x=bool(self.mirror_job.get())
    def apply_active_tool_calibration(self):
        p=self.project.printer;m=self.project.material
        cur=p.apply_tool_calibration(m.mode)
        if cur.get('calibrated'):
            # Drawing always uses calibrated first-contact Z. Cutting may keep
            # a material-specific Z; zero means use the calibrated knife Z.
            if m.mode=='Рисование':
                m.work_z=float(cur['z'])
            elif abs(float(m.work_z or 0.0))<1e-9:
                m.work_z=float(cur['z'])
            m.safe_z=max(float(m.safe_z),float(cur['safe_z']))
        return cur
    def refresh_fields(self):
        m=self.project.material;self.material_var.set(m.name);self.mode.set(m.mode);self.passes.set(m.passes);self.work_speed.set(m.work_speed);self.travel_speed.set(m.travel_speed);self.work_z.set(m.work_z);self.safe_z.set(m.safe_z);self.blade_offset.set(m.blade_offset);self.overcut.set(m.overcut)
        self.drawing_style.set(getattr(m,'drawing_style','Контур + заливка'));self.fill_spacing.set(getattr(m,'fill_spacing',1.0));self.fill_angle.set(getattr(m,'fill_angle',45.0));self.fill_crosshatch.set(bool(getattr(m,'fill_crosshatch',False)));self.fill_inset.set(getattr(m,'fill_inset',0.2));self.pen_press.set(getattr(m,'drawing_press_depth',0.10));self.pen_lift.set(getattr(m,'drawing_lift_height',5.0));self.mirror_job.set(bool(getattr(m,'mirror_x',False)))
        tool='РУЧКА' if m.mode=='Рисование' else 'НОЖ'
        p=self.project.printer
        if p.calibrated:
            self.calib_label.config(text=f'✓ {tool}: Offset X={p.tool_offset_x:.2f}, Y={p.tool_offset_y:.2f}, Z={p.work_z:.3f}',foreground='#15803d')
        else:
            self.calib_label.config(text=f'⚠ {tool}: калибровка не завершена',foreground='#b91c1c')
        self._refresh_mode_buttons();self.update_main_summary()
    def _rebuild_prepared(self):
        try:
            self.prepared_paths=prepare_paths(self.project.objects,self.project.material);self.prepare_error=None
        except Exception as exc:
            self.prepared_paths=[];self.prepare_error=str(exc)
    def refresh_all(self):
        self.apply_active_tool_calibration()
        sel=self.current_index();self._rebuild_prepared();self.listbox.delete(0,'end');[self.listbox.insert('end',o.name) for o in self.project.objects]
        if sel is not None and sel<len(self.project.objects):self.listbox.selection_set(sel);self.listbox.activate(sel)
        self.refresh_fields();self.draw();self.update_status()
    def _canvas_to_bed(self,cx,cy):
        ox,oy=self.origin;z=self.zoom;p=self.project.printer
        return ((cx-ox)/z, p.bed_height-(cy-oy)/z)
    def _bed_to_canvas(self,x,y):
        ox,oy=self.origin;z=self.zoom;p=self.project.printer
        return (ox+x*z,oy+(p.bed_height-y)*z)
    def _object_bounds(self,obj):
        try:return bbox(transformed_paths(obj))
        except Exception:return (0,0,0,0)
    def _sync_transform_fields(self,obj):
        self.vars['x'].set(round(float(obj.x),3));self.vars['y'].set(round(float(obj.y),3))
        self.vars['scale'].set(round(float(obj.scale),4));self.vars['rotation'].set(round(float(obj.rotation_deg),2))
    def _transform_handles(self,index=None):
        if index is None:index=self.current_index()
        if index is None or index<0 or index>=len(self.project.objects):return None
        obj=self.project.objects[index];x0,y0,x1,y1=self._object_bounds(obj)
        A=self._bed_to_canvas(x0,y1);B=self._bed_to_canvas(x1,y0)
        mx=(A[0]+B[0])/2.0
        return {
            'bounds':(A[0],A[1],B[0],B[1]),
            'rotate':(mx,A[1]-28.0),
            'rotate_anchor':(mx,A[1]),
            'scale':(B[0],B[1]),
        }
    def _near_px(self,event,point,radius=None):
        if point is None:return False
        r=float(radius or self._transform_handle_radius)
        return math.hypot(float(event.x)-point[0],float(event.y)-point[1])<=r
    def _point_inside_selected_box(self,event):
        h=self._transform_handles()
        if not h:return False
        x0,y0,x1,y1=h['bounds'];pad=3
        return min(x0,x1)-pad<=event.x<=max(x0,x1)+pad and min(y0,y1)-pad<=event.y<=max(y0,y1)+pad
    def _clamp_object_to_work_area(self,obj):
        x0,y0,x1,y1=self._object_bounds(obj);p=self.project.printer;l,b,r,t=p.safe_bounds
        xl=max(l,float(p.tool_offset_x));xr=min(r,float(p.bed_width)+float(p.tool_offset_x))
        yb=max(b,float(p.tool_offset_y));yt=min(t,float(p.bed_height)+float(p.tool_offset_y))
        if x0<xl:obj.x+=xl-x0
        if x1>xr:obj.x-=x1-xr
        if y0<yb:obj.y+=yb-y0
        if y1>yt:obj.y-=y1-yt
    def on_canvas_press(self,event):
        x,y=self._canvas_to_bed(event.x,event.y)
        sel=self.current_index();handles=self._transform_handles(sel)
        action=None;hit=sel
        if handles and self._near_px(event,handles['rotate'],14):
            action='rotate'
        elif handles and self._near_px(event,handles['scale'],14):
            action='scale'
        else:
            hit=None
            for i in range(len(self.project.objects)-1,-1,-1):
                x0,y0,x1,y1=self._object_bounds(self.project.objects[i])
                if x0-2<=x<=x1+2 and y0-2<=y<=y1+2:
                    hit=i;break
            if hit is not None:action='move'
        if hit is None:
            self.listbox.selection_clear(0,'end');self._drag=None;self._drag_active=False;self.draw();return
        self.listbox.selection_clear(0,'end');self.listbox.selection_set(hit);self.listbox.activate(hit);self.load_obj_fields()
        self.checkpoint();o=self.project.objects[hit];center=object_world_center(o)
        drag={
            'index':hit,'action':action,'start_pointer':(x,y),'start_xy':(float(o.x),float(o.y)),
            'start_scale':float(o.scale),'start_rotation':float(o.rotation_deg),'center':center,
        }
        if action=='rotate':
            drag['start_angle']=math.atan2(y-center[1],x-center[0])
        elif action=='scale':
            drag['start_distance']=max(1e-6,math.hypot(x-center[0],y-center[1]))
        self._drag=drag;self._drag_active=True
    def on_canvas_drag(self,event):
        if not self._drag:return
        i=self._drag['index']
        if i>=len(self.project.objects):return
        x,y=self._canvas_to_bed(event.x,event.y);o=self.project.objects[i];action=self._drag.get('action','move')
        if action=='move':
            sx,sy=self._drag['start_pointer'];ox0,oy0=self._drag['start_xy']
            o.x=ox0+(x-sx);o.y=oy0+(y-sy);self._clamp_object_to_work_area(o)
        elif action=='rotate':
            cx,cy=self._drag['center'];ang=math.atan2(y-cy,x-cx)
            deg=self._drag['start_rotation']+math.degrees(ang-self._drag['start_angle'])
            # Holding Shift snaps to 15 degrees; otherwise rotation is continuous.
            if int(getattr(event,'state',0)) & 0x0001:deg=round(deg/15.0)*15.0
            deg=((deg+180.0)%360.0)-180.0
            set_object_transform_about_center(o,self._drag['center'],scale=self._drag['start_scale'],rotation_deg=deg)
        elif action=='scale':
            cx,cy=self._drag['center'];dist=max(1e-6,math.hypot(x-cx,y-cy));ratio=dist/self._drag['start_distance']
            new_scale=max(0.01,min(100.0,self._drag['start_scale']*ratio))
            set_object_transform_about_center(o,self._drag['center'],scale=new_scale,rotation_deg=self._drag['start_rotation'])
        self._sync_transform_fields(o);self.draw()
    def on_canvas_release(self,event):
        if not self._drag:return
        self._drag=None;self._drag_active=False;self.refresh_all()
    def on_canvas_hover(self,event):
        try:
            h=self._transform_handles()
            if h and self._near_px(event,h['rotate'],14):cursor='crosshair'
            elif h and self._near_px(event,h['scale'],14):cursor='sizing'
            elif h and self._point_inside_selected_box(event):cursor='fleur'
            else:cursor=''
            self.canvas.configure(cursor=cursor)
        except Exception:
            try:self.canvas.configure(cursor='')
            except Exception:pass
    def set_zoom(self,z):self.zoom=max(0.4,min(8,z));self.draw()
    def on_wheel(self,e):self.set_zoom(self.zoom*(1.12 if e.delta>0 else 1/1.12))
    def draw(self):
        c=self.canvas;c.delete('all');ox,oy=self.origin;z=self.zoom;p=self.project.printer
        def pt(x,y):return ox+x*z, oy+(p.bed_height-y)*z
        x0,y0=pt(0,p.bed_height);x1,y1=pt(p.bed_width,0);c.create_rectangle(x0,y0,x1,y1,fill='white',outline='#64748b',width=2)
        for x in range(0,257,10):
            a=pt(x,0);b=pt(x,p.bed_height);c.create_line(*a,*b,fill='#e2e8f0')
        for y in range(0,257,10):
            a=pt(0,y);b=pt(p.bed_width,y);c.create_line(*a,*b,fill='#e2e8f0')
        l,bm,r,t=p.safe_bounds
        A=pt(0,p.bed_height);B=pt(p.bed_width,t);c.create_rectangle(A[0],A[1],B[0],B[1],fill='#e5e7eb',outline='')
        A=pt(0,bm);B=pt(p.bed_width,0);c.create_rectangle(A[0],A[1],B[0],B[1],fill='#e5e7eb',outline='')
        A=pt(0,t);B=pt(l,bm);c.create_rectangle(A[0],A[1],B[0],B[1],fill='#e5e7eb',outline='')
        A=pt(r,t);B=pt(p.bed_width,bm);c.create_rectangle(A[0],A[1],B[0],B[1],fill='#e5e7eb',outline='')
        a=pt(l,bm);bb=pt(r,t);c.create_rectangle(a[0],bb[1],bb[0],a[1],outline='#64748b',dash=(5,4),width=2)
        if self._drag_active:
            paths=[]
            for obj in self.project.objects:paths.extend(transformed_paths(obj))
        else:
            paths=self.prepared_paths
        prev=None
        for idx,path in enumerate(paths,1):
            if not path:continue
            if prev is not None:
                a=pt(*prev);bq=pt(*path[0]);c.create_line(*a,*bq,fill='#2563eb',dash=(4,3),width=1)
            xy=[];step=max(1,len(path)//1200);sample=path[::step]
            if path and sample[-1]!=path[-1]:sample=sample+[path[-1]]
            for x,y in sample:xy+=pt(x,y)
            if len(xy)>=4:c.create_line(*xy,fill='#dc2626',width=2)
            if len(path)>=2 and idx<=300:
                q0=pt(*path[0]);q1=pt(*path[min(1,len(path)-1)]);c.create_line(*q0,*q1,fill='#dc2626',width=2,arrow='last')
                c.create_text(q0[0]+5,q0[1]-5,text=str(idx),anchor='sw',fill='#7f1d1d')
            prev=path[-1]
        sel=self.current_index()
        if sel is not None and sel<len(self.project.objects):
            h=self._transform_handles(sel)
            if h:
                xa,ya,xb,yb=h['bounds'];rx,ry=h['rotate'];rax,ray=h['rotate_anchor'];sx,sy=h['scale']
                c.create_rectangle(xa,ya,xb,yb,outline='#0f766e',dash=(6,3),width=2)
                c.create_line(rax,ray,rx,ry,fill='#0f766e',width=2)
                c.create_oval(rx-7,ry-7,rx+7,ry+7,fill='#ffffff',outline='#0f766e',width=3)
                c.create_rectangle(sx-7,sy-7,sx+7,sy+7,fill='#0f766e',outline='#ffffff',width=2)
                o=self.project.objects[sel]
                c.create_text(rx+14,ry,text=f'{o.rotation_deg:.1f}°',anchor='w',fill='#0f766e',font=('Segoe UI',9,'bold'))
                c.create_text(sx-10,sy+12,text=f'{o.scale:.3f}×',anchor='ne',fill='#0f766e',font=('Segoe UI',9,'bold'))
        c.create_text(ox+8,oy+8,text='ЛКМ: двигать  •  ○: вращать  •  ■: масштаб  •  Shift при вращении: шаг 15°',anchor='nw',fill='#334155')

    def update_status(self):
        try:
            if self.prepare_error:
                self.status.config(text=self.prepare_error);self.warn.config(text='');return
            paths=self.prepared_paths
            if not paths:
                self.status.config(text='Нет траекторий');self.warn.config(text='');return
            info=analyze_path_bounds(paths,self.project.printer);b=info['tool_bounds'];length=sum(path_length(p) for p in paths);m=self.project.material
            est=length/max(0.1,m.work_speed)*max(1,m.passes);kind='рисования' if m.mode=='Рисование' else 'реза'
            self.status.config(text=f'Траекторий: {len(paths)}   Длина {kind}: {length:.1f} мм   ≈ {est:.0f} с   Инструмент: X {b[0]:.1f}…{b[2]:.1f}, Y {b[1]:.1f}…{b[3]:.1f} мм')
            if info['outside_physical']:
                self.warn.config(text='⛔ Траектория выходит ЗА ФИЗИЧЕСКИЕ ГРАНИЦЫ СТОЛА',foreground='#b91c1c')
            elif info['outside_safe']:
                self.warn.config(text='⚠ Траектория выходит за безопасную область',foreground='#b45309')
            else:
                self.warn.config(text='',foreground='#b45309')
        except Exception as e:self.status.config(text=str(e));self.warn.config(text='')
    def save_project(self):
        self.sync_material();f=self.current_file or filedialog.asksaveasfilename(defaultextension='.ncut',filetypes=[('Sibir Cut project','*.ncut')]);
        if f:save_project(self.project,f);self.current_file=f
    def open_project(self):
        f=filedialog.askopenfilename(filetypes=[('Sibir Cut project','*.ncut')]);
        if f:
            try:self.project=load_project(f);self.current_file=f;self.refresh_all()
