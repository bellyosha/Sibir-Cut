        w=tk.Toplevel(self);w.title('Профиль оборудования — Bambu Lab A1 + UMTS');w.geometry('760x760');w.transient(self);w.grab_set();p=self.project.printer
        outer=ttk.Frame(w,padding=10);outer.pack(fill='both',expand=True);canvas=tk.Canvas(outer,highlightthickness=0);sb=ttk.Scrollbar(outer,orient='vertical',command=canvas.yview);inner=ttk.Frame(canvas);inner.bind('<Configure>',lambda e:canvas.configure(scrollregion=canvas.bbox('all')));canvas.create_window((0,0),window=inner,anchor='nw');canvas.configure(yscrollcommand=sb.set);canvas.pack(side='left',fill='both',expand=True);sb.pack(side='right',fill='y')
        vals={}
        fields=[('name','Название'),('bed_width','Ширина поля, мм'),('bed_height','Высота поля, мм'),('margin_left','Отступ слева'),('margin_right','Отступ справа'),('margin_bottom','Отступ снизу'),('margin_top','Отступ сверху'),('tool_offset_x','Смещение инструмента X'),('tool_offset_y','Смещение инструмента Y'),('work_z','Рабочая высота Z'),('safe_z','Безопасная высота Z'),('park_x','Парковка установки X'),('park_y','Парковка установки Y'),('max_work_speed','Макс. рабочая скорость'),('max_travel_speed','Макс. холостая скорость'),('max_accel','Макс. ускорение'),('min_z','Минимальный Z'),('max_z','Максимальный Z')]
        for key,lab in fields:
            r=ttk.Frame(inner);r.pack(fill='x',pady=2);ttk.Label(r,text=lab,width=29).pack(side='left');v=tk.StringVar(value=str(getattr(p,key)));ttk.Entry(r,textvariable=v).pack(side='left',fill='x',expand=True);vals[key]=v
        ttk.Label(inner,text='Стартовый G-code',style='Title.TLabel').pack(anchor='w',pady=(10,2));start=tk.Text(inner,height=12,wrap='none');start.pack(fill='x');start.insert('1.0',p.start_template)
        ttk.Label(inner,text='Конечный G-code',style='Title.TLabel').pack(anchor='w',pady=(10,2));end=tk.Text(inner,height=9,wrap='none');end.pack(fill='x');end.insert('1.0',p.end_template)
        bar=ttk.Frame(inner);bar.pack(fill='x',pady=10)
        def apply():
            self.checkpoint()
            try:
                for k,v in vals.items():setattr(p,k,v.get() if k=='name' else float(v.get()))
                p.start_template=start.get('1.0','end-1c');p.end_template=end.get('1.0','end-1c');p.calibrated=False
                w.destroy();self.refresh_all()
            except Exception as e:messagebox.showerror('Профиль',str(e),parent=w)
        def exportp():
            f=filedialog.asksaveasfilename(parent=w,defaultextension='.json',filetypes=[('JSON','*.json')]);
            if f:Path(f).write_text(json.dumps(p.to_dict(),ensure_ascii=False,indent=2),encoding='utf-8')
        def importp():
            f=filedialog.askopenfilename(parent=w,filetypes=[('JSON','*.json')]);
            if not f:return
            try:self.checkpoint();self.project.printer=type(p).from_dict(json.loads(Path(f).read_text(encoding='utf-8')));w.destroy();self.refresh_all()
            except Exception as e:messagebox.showerror('Профиль',str(e),parent=w)
        ttk.Button(bar,text='Импорт профиля',command=importp).pack(side='left');ttk.Button(bar,text='Экспорт профиля',command=exportp).pack(side='left',padx=4);ttk.Button(bar,text='Применить (потребуется калибровка)',command=apply).pack(side='right')
    def animate_preview(self):
        paths=self.prepared_paths
        if not paths:return
        self.draw();p=self.project.printer;ox,oy=self.origin;z=self.zoom
        def pt(x,y):return ox+x*z,oy+(p.bed_height-y)*z
        seq=[];prev=(p.park_x,p.park_y)
        for path in paths:
            seq.append(('travel',prev,path[0]));seq.extend(('cut',a,b) for a,b in zip(path,path[1:]));prev=path[-1]
        state={'i':0}
        def step():
            if state['i']>=len(seq):return
            typ,a,b=seq[state['i']];A=pt(*a);B=pt(*b);self.canvas.create_line(*A,*B,fill='#2563eb' if typ=='travel' else '#dc2626',width=3);self.canvas.delete('tool');x,y=B;self.canvas.create_oval(x-4,y-4,x+4,y+4,fill='#16a34a',outline='',tags='tool');state['i']+=1;self.after(35,step)
        step()

    def _placement_ok(self):
        if not self.project.objects:return False,'Нет объектов'
        paths=self.prepared_paths
        if not paths:return False,'Нет готовой траектории'
        info=analyze_path_bounds(paths,self.project.printer);x0,y0,x1,y1=info['tool_bounds'];l,b,r,t=self.project.printer.safe_bounds
        ok=not info['outside_safe'] and not info['outside_physical']
        prefix='Траектория инструмента'
        return ok,f'{prefix}: X {x0:.1f}…{x1:.1f} мм, Y {y0:.1f}…{y1:.1f} мм; безопасная зона X {l:.1f}…{r:.1f}, Y {b:.1f}…{t:.1f}'

    def launch_wizard(self):
        old=getattr(self,'_wizard',None)
        if old is not None:
            try:
                if old.winfo_exists():old.lift();return
            except Exception:pass
        w=tk.Toplevel(self);self._wizard=w;w.title('Мастер подготовки и запуска — Novatech Cut');w.geometry('780x650');w.minsize(700,560);w.transient(self)
        step={'i':0};titles=['Файл','Размещение','Режим и материал','Калибровка A1 + UMTS','Воздушный тест','Экспорт и запуск']
        top=ttk.Frame(w,padding=12);top.pack(fill='x');step_label=ttk.Label(top,text='',style='Title.TLabel');step_label.pack(anchor='w');desc=ttk.Label(top,text='',wraplength=730);desc.pack(anchor='w',pady=(4,0))
        body=ttk.Frame(w,padding=(16,8));body.pack(fill='both',expand=True)
        nav=ttk.Frame(w,padding=12);nav.pack(fill='x');back=ttk.Button(nav,text='← Назад');back.pack(side='left');nextb=ttk.Button(nav,text='Далее →');nextb.pack(side='right');ttk.Button(nav,text='Закрыть',command=w.destroy).pack(side='right',padx=8)

        m=self.project.material
        wm=tk.StringVar(value=m.mode);wmat=tk.StringVar(value=m.name);wstyle=tk.StringVar(value=getattr(m,'drawing_style','Контур + заливка'))
        wspacing=tk.DoubleVar(value=getattr(m,'fill_spacing',1.0));wangle=tk.DoubleVar(value=getattr(m,'fill_angle',45.0));wcross=tk.BooleanVar(value=getattr(m,'fill_crosshatch',False));winset=tk.DoubleVar(value=getattr(m,'fill_inset',0.2));wpress=tk.DoubleVar(value=getattr(m,'drawing_press_depth',0.10));wlift=tk.DoubleVar(value=getattr(m,'drawing_lift_height',5.0))
        wpasses=tk.IntVar(value=m.passes);wspeed=tk.DoubleVar(value=m.work_speed);wblade=tk.DoubleVar(value=m.blade_offset);wover=tk.DoubleVar(value=m.overcut)

        def clear():
            for child in body.winfo_children():child.destroy()
        def note(text,kind='normal'):
            fg={'ok':'#15803d','warn':'#b45309','bad':'#b91c1c'}.get(kind,'#334155')
            ttk.Label(body,text=text,wraplength=720,foreground=fg,justify='left').pack(fill='x',anchor='w',pady=6)
        def load_material(event=None):
            prof=next((x for x in DEFAULT_MATERIALS if x.name==wmat.get()),None)
            if not prof:return
            wm.set(prof.mode);wpasses.set(prof.passes);wspeed.set(prof.work_speed);wblade.set(prof.blade_offset);wover.set(prof.overcut);wstyle.set(getattr(prof,'drawing_style','Контур + заливка'));wspacing.set(getattr(prof,'fill_spacing',1.0));wangle.set(getattr(prof,'fill_angle',45.0));wcross.set(getattr(prof,'fill_crosshatch',False));winset.set(getattr(prof,'fill_inset',0.2));wpress.set(getattr(prof,'drawing_press_depth',0.10));wlift.set(getattr(prof,'drawing_lift_height',5.0))
            if step['i']==2:render()
        def apply_settings():
            prof=next((x for x in DEFAULT_MATERIALS if x.name==wmat.get()),None)
            if prof:self.project.material=MaterialProfile.from_dict(prof.to_dict())
            mm=self.project.material;mm.name=wmat.get();mm.mode=wm.get();mm.passes=max(1,wpasses.get());mm.work_speed=max(0.1,wspeed.get());mm.blade_offset=max(0,wblade.get());mm.overcut=max(0,wover.get());mm.drawing_style=wstyle.get();mm.fill_spacing=max(0.1,wspacing.get());mm.fill_angle=wangle.get();mm.fill_crosshatch=bool(wcross.get());mm.fill_inset=max(0,winset.get());mm.drawing_press_depth=max(0,wpress.get());mm.drawing_lift_height=max(0,wlift.get())
            self._air_test_exported=False;self.refresh_all()
        def center_selected():
            if not self.project.objects:return
            if self.current_index() is None:self.listbox.selection_set(0);self.listbox.activate(0)
            self.align('center');render()
        def open_export_folder():
            if not self.last_export_path:
                messagebox.showinfo('Папка','Сначала экспортируйте файл.',parent=w);return
            folder=str(Path(self.last_export_path).parent)
            try:os.startfile(folder)
            except Exception as exc:messagebox.showerror('Папка',str(exc),parent=w)

        def render():
            clear();i=step['i'];step_label.config(text=f'Шаг {i+1} из {len(titles)} — {titles[i]}')
            back.config(state='normal' if i>0 else 'disabled');nextb.config(text='Готово' if i==len(titles)-1 else 'Далее →')
            if i==0:
                desc.config(text='Сначала нужен объект для резки или рисования.')
                if self.project.objects:note(f'✓ Загружено объектов: {len(self.project.objects)}','ok')
                else:note('Файл ещё не загружен. Нажмите «Импорт» в главном окне или кнопку ниже.','bad')
                ttk.Button(body,text='Импортировать файл…',command=self.do_import).pack(anchor='w',pady=10)
                note('Для растровой картинки выбирайте «Нет» на вопрос про осевые линии, если нужно вырезать контур или полностью закрашивать фигуру.')
            elif i==1:
                desc.config(text='Разместите объект на столе. Теперь его можно хватать левой кнопкой мыши прямо в главном координатном поле и перетаскивать.')
                ok,msg=self._placement_ok();note(('✓ ' if ok else '⚠ ')+msg,'ok' if ok else 'warn')
                note('Окно мастера не блокирует главное окно: потяните объект мышкой. Зелёная пунктирная рамка показывает выбранный объект. Точные X/Y остаются слева.')
                ttk.Button(body,text='Поставить выбранный объект по центру',command=center_selected).pack(anchor='w',pady=8)
                ttk.Button(body,text='Обновить проверку размещения',command=render).pack(anchor='w')
            elif i==2:
                desc.config(text='Выберите, что делает инструмент. Для ножа нужна «Резка» — только границы. Для ручки/маркера «Рисование» может обводить и закрашивать всю площадь.')
                grid=ttk.Frame(body);grid.pack(fill='x',anchor='n')
                ttk.Label(grid,text='Профиль материала / инструмента').grid(row=0,column=0,sticky='w',pady=4);cb=ttk.Combobox(grid,textvariable=wmat,values=[x.name for x in DEFAULT_MATERIALS],state='readonly',width=34);cb.grid(row=0,column=1,sticky='ew',pady=4);cb.bind('<<ComboboxSelected>>',load_material)
                ttk.Label(grid,text='Операция').grid(row=1,column=0,sticky='w',pady=4);ttk.Combobox(grid,textvariable=wm,values=['Резка','Рисование'],state='readonly').grid(row=1,column=1,sticky='ew',pady=4)
                ttk.Label(grid,text='Рабочая скорость, мм/с').grid(row=2,column=0,sticky='w',pady=4);ttk.Entry(grid,textvariable=wspeed).grid(row=2,column=1,sticky='ew',pady=4)
                ttk.Label(grid,text='Проходов').grid(row=3,column=0,sticky='w',pady=4);ttk.Entry(grid,textvariable=wpasses).grid(row=3,column=1,sticky='ew',pady=4)
                cut=ttk.LabelFrame(body,text='Если выбрана резка',padding=8);cut.pack(fill='x',pady=8)
                ttk.Label(cut,text='Blade offset, мм').grid(row=0,column=0,sticky='w');ttk.Entry(cut,textvariable=wblade,width=12).grid(row=0,column=1,padx=8);ttk.Label(cut,text='Overcut, мм').grid(row=0,column=2,sticky='w');ttk.Entry(cut,textvariable=wover,width=12).grid(row=0,column=3,padx=8)
                draw=ttk.LabelFrame(body,text='Если выбрано рисование',padding=8);draw.pack(fill='x',pady=8)
                ttk.Label(draw,text='Режим').grid(row=0,column=0,sticky='w');ttk.Combobox(draw,textvariable=wstyle,values=['Контур + заливка','Только заливка','Только контур'],state='readonly',width=24).grid(row=0,column=1,columnspan=3,sticky='ew',padx=8)
                ttk.Label(draw,text='Шаг заливки, мм').grid(row=1,column=0,sticky='w');ttk.Entry(draw,textvariable=wspacing,width=10).grid(row=1,column=1,padx=8);ttk.Label(draw,text='Угол, °').grid(row=1,column=2,sticky='w');ttk.Entry(draw,textvariable=wangle,width=10).grid(row=1,column=3,padx=8)
                ttk.Label(draw,text='Отступ от края, мм').grid(row=2,column=0,sticky='w');ttk.Entry(draw,textvariable=winset,width=10).grid(row=2,column=1,padx=8);ttk.Checkbutton(draw,text='Перекрёстная заливка',variable=wcross).grid(row=2,column=2,columnspan=2,sticky='w')
                ttk.Label(draw,text='Прижим ручки, мм').grid(row=3,column=0,sticky='w');ttk.Entry(draw,textvariable=wpress,width=10).grid(row=3,column=1,padx=8);ttk.Label(draw,text='Подъём ручки, мм').grid(row=3,column=2,sticky='w');ttk.Entry(draw,textvariable=wlift,width=10).grid(row=3,column=3,padx=8)
                grid.columnconfigure(1,weight=1)
                note('Для заполненных букв: «Рисование» → «Контур + заливка». Z калибровки — первое касание без нажима. Начните с прижима 0,05–0,10 мм и подъёма 5 мм.')
            elif i==3:
                desc.config(text='Калибровка сообщает программе, где относительно сопла находится UMTS и на какой Z инструмент касается материала. Homing теперь выполняется ВРУЧНУЮ до запуска файла, пока UMTS снят.')
                p=self.project.printer
                if p.calibrated:note(f'✓ Профиль откалиброван. Offset X={p.tool_offset_x:.2f}, Y={p.tool_offset_y:.2f}; Z первого касания={p.work_z:.2f}; минимальная безопасная Z={p.safe_z:.2f}.','ok')
                else:note('Профиль ещё не откалиброван. Реальный экспорт заблокирован.','bad')
                note('Что означает каждый параметр:\n• Offset X/Y — смещение кончика ножа/ручки от сопла.\n• Z первого касания — ручка только начинает касаться материала, БЕЗ нажима.\n• Минимальная безопасная Z — инструмент гарантированно не касается материала.\n• Для рисования фактический прижим и подъём задаются отдельно в параметрах задания.\n\nПеред КАЖДЫМ запуском задания сначала выполните штатный Home на экране A1 при СНЯТОМ UMTS. Сам файл больше не вызывает G28, чтобы не запускать лишний сервисный цикл. Значения Z нельзя угадывать.')
                ttk.Button(body,text='Открыть мастер калибровки',command=self.calibrate).pack(anchor='w',pady=8);ttk.Button(body,text='Обновить статус',command=render).pack(anchor='w')
            elif i==4:
                desc.config(text='Сначала проверяем траекторию без касания материала. Это обязательный этап перед первым реальным запуском.')
                if self._air_test_exported:note('✓ Воздушный тест для текущего задания сохранён.','ok')
                else:note('Воздушный тест ещё не сохранён.','warn')
                note('1. UMTS снят.\n2. На экране A1 ВРУЧНУЮ выполните Home.\n3. После завершения Home запустите воздушный файл.\n4. Файл сразу отключит нагрев сопла/стола и переместит головку к переднему краю стола (по умолчанию X128 Y10).\n5. На паузе установите UMTS и продолжите.\n6. Убедитесь, что инструмент нигде не касается стола и вся траектория остаётся в нужной зоне.')
                def air():
                    if self.export(air=True,show_message=False):messagebox.showinfo('Воздушный тест','Файл сохранён. Перенесите его на принтер и проверьте движение без касания материала.',parent=w);render()
                ttk.Button(body,text='Сохранить файл воздушного теста…',command=air).pack(anchor='w',pady=8)
            else:
                desc.config(text='После успешного воздушного теста можно сформировать рабочий файл и запустить его на A1.')
                note('В этой версии Novatech Cut готовит проверенный .gcode.3mf, но не отправляет его на принтер по сети автоматически.')
                note('Порядок запуска на A1:\n1. Сохраните рабочий .gcode.3mf.\n2. Перенесите файл на носитель/в принтер.\n3. UMTS СНЯТ. На экране A1 вручную выполните Home.\n4. Только после завершения Home запустите файл.\n5. Файл принудительно задаёт M104 S0 / M140 S0, затем головка идёт к переднему краю X128 Y10.\n6. На первой паузе установите UMTS и продолжите.\n7. Выполнится резка/рисование без нагрева и экструзии.\n8. В конце головка снова идёт к переднему краю; на второй паузе снимите UMTS.','warn')
                def final_export():
                    if not self._air_test_exported:
                        if not messagebox.askyesno('Воздушный тест','Для текущего задания не отмечен сохранённый воздушный тест. Всё равно перейти к экспорту?',parent=w):return
                    if self.export(air=False,show_message=False):messagebox.showinfo('Рабочий файл','Рабочий файл создан. Теперь перенесите его на принтер по инструкции в этом окне.',parent=w);render()
                ttk.Button(body,text='Экспортировать рабочий .gcode.3mf…',style='Danger.TButton',command=final_export).pack(anchor='w',pady=8)
                ttk.Button(body,text='Открыть папку последнего экспорта',command=open_export_folder).pack(anchor='w')
        def go(delta):
            i=step['i']
            if delta>0:
                if i==0 and not self.project.objects:messagebox.showwarning('Шаг 1','Сначала импортируйте хотя бы один объект.',parent=w);return
                if i==1:
                    ok,msg=self._placement_ok()
                    if not ok:messagebox.showwarning('Размещение','Объект выходит за безопасную область. Перетащите его на поле или используйте кнопку центрирования.',parent=w);return
                if i==2:
                    try:apply_settings()
                    except Exception as exc:messagebox.showerror('Параметры',str(exc),parent=w);return
                if i==3 and not self.project.printer.calibrated:messagebox.showwarning('Калибровка','Сначала завершите калибровку профиля A1 + UMTS.',parent=w);return
                if i==4 and not self._air_test_exported:messagebox.showwarning('Воздушный тест','Сначала сохраните и проверьте воздушный тест.',parent=w);return
                if i==len(titles)-1:w.destroy();return
            step['i']=max(0,min(len(titles)-1,i+delta));render()
        back.config(command=lambda:go(-1));nextb.config(command=lambda:go(1))
        def closed():self._wizard=None;w.destroy()
        w.protocol('WM_DELETE_WINDOW',closed);render()

