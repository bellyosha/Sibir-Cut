            if prev is not None:
                a=pt(*prev);bq=pt(*path[0]);c.create_line(*a,*bq,fill='#2563eb',dash=(4,3),width=1)
            xy=[];step=max(1,len(path)//1200);sample=path[::step]
            if path and sample[-1]!=path[-1]:sample=sample+[path[-1]]
            for x,y in sample:xy+=pt(x,y)
            if len(xy)>=4:c.create_line(*xy,fill='#dc2626',width=2)
            if len(path)>=2 and idx<=300:
                q0=pt(*path[0]);q1=pt(*path[min(1,len(path)-1)]);c.create_line(*q0,*q1,fill='#dc2626',width=2,arrow='last')
                c.create_text(q0[0]+5,q0[1]-5,text=str(idx),anchor='sw',fill='#7f1d1d')
            prev=path[-1]
        sel=self.current_index()
        if sel is not None and sel<len(self.project.objects):
            x0s,y0s,x1s,y1s=self._object_bounds(self.project.objects[sel]);A=pt(x0s,y1s);B=pt(x1s,y0s)
            c.create_rectangle(A[0],A[1],B[0],B[1],outline='#16a34a',dash=(6,3),width=2)
        c.create_text(ox+8,oy+8,text='Bambu Lab A1 — 256 × 256 мм   •   ЛКМ: выбрать и перетащить',anchor='nw',fill='#334155')
    def update_status(self):
        try:
            if self.prepare_error:
                self.status.config(text=self.prepare_error);self.warn.config(text='');return
            paths=self.prepared_paths;b=bbox(paths);length=sum(path_length(p) for p in paths);m=self.project.material
            est=length/max(0.1,m.work_speed)*max(1,m.passes);kind='рисования' if m.mode=='Рисование' else 'реза';self.status.config(text=f'Траекторий: {len(paths)}   Длина {kind}: {length:.1f} мм   ≈ {est:.0f} с   Границы: {b[0]:.1f},{b[1]:.1f} — {b[2]:.1f},{b[3]:.1f} мм')
            l,bb,r,t=self.project.printer.safe_bounds;bad=bool(paths) and (b[0]<l or b[1]<bb or b[2]>r or b[3]>t);self.warn.config(text='⚠ Выход за безопасную область' if bad else '')
        except Exception as e:self.status.config(text=str(e));self.warn.config(text='')
    def save_project(self):
        self.sync_material();f=self.current_file or filedialog.asksaveasfilename(defaultextension='.ncut',filetypes=[('Novatech Cut project','*.ncut')]);
        if f:save_project(self.project,f);self.current_file=f
    def open_project(self):
        f=filedialog.askopenfilename(filetypes=[('Novatech Cut project','*.ncut')]);
        if f:
            try:self.project=load_project(f);self.current_file=f;self.refresh_all()
            except Exception as e:messagebox.showerror('Проект',str(e))
    def printer_profile(self):
        w=tk.Toplevel(self);w.title('Профиль оборудования — Bambu Lab A1 + UMTS');w.geometry('760x760');w.transient(self);w.grab_set();p=self.project.printer
        outer=ttk.Frame(w,padding=10);outer.pack(fill='both',expand=True);canvas=tk.Canvas(outer,highlightthickness=0);sb=ttk.Scrollbar(outer,orient='vertical',command=canvas.yview);inner=ttk.Frame(canvas);inner.bind('<Configure>',lambda e:canvas.configure(scrollregion=canvas.bbox('all')));canvas.create_window((0,0),window=inner,anchor='nw');canvas.configure(yscrollcommand=sb.set);canvas.pack(side='left',fill='both',expand=True);sb.pack(side='right',fill='y')
        vals={}
        fields=[('name','Название'),('bed_width','Ширина поля, мм'),('bed_height','Высота поля, мм'),('margin_left','Отступ слева'),('margin_right','Отступ справа'),('margin_bottom','Отступ снизу'),('margin_top','Отступ сверху'),('tool_offset_x','Смещение инструмента X'),('tool_offset_y','Смещение инструмента Y'),('work_z','Рабочая высота Z'),('safe_z','Безопасная высота Z'),('park_x','Парковка X'),('park_y','Парковка Y'),('max_work_speed','Макс. рабочая скорость'),('max_travel_speed','Макс. холостая скорость'),('max_accel','Макс. ускорение'),('min_z','Минимальный Z'),('max_z','Максимальный Z')]
        for key,lab in fields:
            r=ttk.Frame(inner);r.pack(fill='x',pady=2);ttk.Label(r,text=lab,width=29).pack(side='left');v=tk.StringVar(value=str(getattr(p,key)));ttk.Entry(r,textvariable=v).pack(side='left',fill='x',expand=True);vals[key]=v
        ttk.Label(inner,text='Стартовый G-code',style='Title.TLabel').pack(anchor='w',pady=(10,2));start=tk.Text(inner,height=12,wrap='none');start.pack(fill='x');start.insert('1.0',p.start_template)
        ttk.Label(inner,text='Конечный G-code',style='Title.TLabel').pack(anchor='w',pady=(10,2));end=tk.Text(inner,height=9,wrap='none');end.pack(fill='x');end.insert('1.0',p.end_template)
        bar=ttk.Frame(inner);bar.pack(fill='x',pady=10)
        def apply():
            self.checkpoint()
            try:
                for k,v in vals.items():setattr(p,k,v.get() if k=='name' else float(v.get()))
                p.start_template=start.get('1.0','end-1c');p.end_template=end.get('1.0','end-1c');p.calibrated=False
                w.destroy();self.refresh_all()
            except Exception as e:messagebox.showerror('Профиль',str(e),parent=w)
        def exportp():
            f=filedialog.asksaveasfilename(parent=w,defaultextension='.json',filetypes=[('JSON','*.json')]);
            if f:Path(f).write_text(json.dumps(p.to_dict(),ensure_ascii=False,indent=2),encoding='utf-8')
        def importp():
            f=filedialog.askopenfilename(parent=w,filetypes=[('JSON','*.json')]);
            if not f:return
            try:self.checkpoint();self.project.printer=type(p).from_dict(json.loads(Path(f).read_text(encoding='utf-8')));w.destroy();self.refresh_all()
            except Exception as e:messagebox.showerror('Профиль',str(e),parent=w)
        ttk.Button(bar,text='Импорт профиля',command=importp).pack(side='left');ttk.Button(bar,text='Экспорт профиля',command=exportp).pack(side='left',padx=4);ttk.Button(bar,text='Применить (потребуется калибровка)',command=apply).pack(side='right')
    def animate_preview(self):
        paths=self.prepared_paths
        if not paths:return
        self.draw();p=self.project.printer;ox,oy=self.origin;z=self.zoom
        def pt(x,y):return ox+x*z,oy+(p.bed_height-y)*z
        seq=[];prev=(p.park_x,p.park_y)
        for path in paths:
            seq.append(('travel',prev,path[0]));seq.extend(('cut',a,b) for a,b in zip(path,path[1:]));prev=path[-1]
        state={'i':0}
        def step():
            if state['i']>=len(seq):return
            typ,a,b=seq[state['i']];A=pt(*a);B=pt(*b);self.canvas.create_line(*A,*B,fill='#2563eb' if typ=='travel' else '#dc2626',width=3);self.canvas.delete('tool');x,y=B;self.canvas.create_oval(x-4,y-4,x+4,y+4,fill='#16a34a',outline='',tags='tool');state['i']+=1;self.after(35,step)
        step()

    def _placement_ok(self):
        if not self.project.objects:return False,'Нет объектов'
        raw=[]
        for obj in self.project.objects:raw.extend(transformed_paths(obj))
        if not raw:return False,'Нет геометрии'
        x0,y0,x1,y1=bbox(raw);l,b,r,t=self.project.printer.safe_bounds
        ok=x0>=l-1e-6 and y0>=b-1e-6 and x1<=r+1e-6 and y1<=t+1e-6
        return ok,f'Объект: X {x0:.1f}…{x1:.1f} мм, Y {y0:.1f}…{y1:.1f} мм; безопасная зона X {l:.1f}…{r:.1f}, Y {b:.1f}…{t:.1f}'

    def launch_wizard(self):
        old=getattr(self,'_wizard',None)
        if old is not None:
            try:
                if old.winfo_exists():old.lift();return
            except Exception:pass
        w=tk.Toplevel(self);self._wizard=w;w.title('Мастер подготовки и запуска — Novatech Cut');w.geometry('780x650');w.minsize(700,560);w.transient(self)
        step={'i':0};titles=['Файл','Размещение','Режим и материал','Калибровка A1 + UMTS','Воздушный тест','Экспорт и запуск']
        top=ttk.Frame(w,padding=12);top.pack(fill='x');step_label=ttk.Label(top,text='',style='Title.TLabel');step_label.pack(anchor='w');desc=ttk.Label(top,text='',wraplength=730);desc.pack(anchor='w',pady=(4,0))
        body=ttk.Frame(w,padding=(16,8));body.pack(fill='both',expand=True)
        nav=ttk.Frame(w,padding=12);nav.pack(fill='x');back=ttk.Button(nav,text='← Назад');back.pack(side='left');nextb=ttk.Button(nav,text='Далее →');nextb.pack(side='right');ttk.Button(nav,text='Закрыть',command=w.destroy).pack(side='right',padx=8)

        m=self.project.material
        wm=tk.StringVar(value=m.mode);wmat=tk.StringVar(value=m.name);wstyle=tk.StringVar(value=getattr(m,'drawing_style','Контур + заливка'))
        wspacing=tk.DoubleVar(value=getattr(m,'fill_spacing',1.0));wangle=tk.DoubleVar(value=getattr(m,'fill_angle',45.0));wcross=tk.BooleanVar(value=getattr(m,'fill_crosshatch',False));winset=tk.DoubleVar(value=getattr(m,'fill_inset',0.2))
        wpasses=tk.IntVar(value=m.passes);wspeed=tk.DoubleVar(value=m.work_speed);wblade=tk.DoubleVar(value=m.blade_offset);wover=tk.DoubleVar(value=m.overcut)

        def clear():
            for child in body.winfo_children():child.destroy()
        def note(text,kind='normal'):
            fg={'ok':'#15803d','warn':'#b45309','bad':'#b91c1c'}.get(kind,'#334155')
            ttk.Label(body,text=text,wraplength=720,foreground=fg,justify='left').pack(fill='x',anchor='w',pady=6)
        def load_material(event=None):
            prof=next((x for x in DEFAULT_MATERIALS if x.name==wmat.get()),None)
            if not prof:return
            wm.set(prof.mode);wpasses.set(prof.passes);wspeed.set(prof.work_speed);wblade.set(prof.blade_offset);wover.set(prof.overcut);wstyle.set(getattr(prof,'drawing_style','Контур + заливка'));wspacing.set(getattr(prof,'fill_spacing',1.0));wangle.set(getattr(prof,'fill_angle',45.0));wcross.set(getattr(prof,'fill_crosshatch',False));winset.set(getattr(prof,'fill_inset',0.2))
            if step['i']==2:render()
        def apply_settings():
            prof=next((x for x in DEFAULT_MATERIALS if x.name==wmat.get()),None)
            if prof:self.project.material=MaterialProfile.from_dict(prof.to_dict())
            mm=self.project.material;mm.name=wmat.get();mm.mode=wm.get();mm.passes=max(1,wpasses.get());mm.work_speed=max(0.1,wspeed.get());mm.blade_offset=max(0,wblade.get());mm.overcut=max(0,wover.get());mm.drawing_style=wstyle.get();mm.fill_spacing=max(0.1,wspacing.get());mm.fill_angle=wangle.get();mm.fill_crosshatch=bool(wcross.get());mm.fill_inset=max(0,winset.get())
            self._air_test_exported=False;self.refresh_all()
        def center_selected():
            if not self.project.objects:return
            if self.current_index() is None:self.listbox.selection_set(0);self.listbox.activate(0)
            self.align('center');render()
        def open_export_folder():
            if not self.last_export_path:
                messagebox.showinfo('Папка','Сначала экспортируйте файл.',parent=w);return
            folder=str(Path(self.last_export_path).parent)
            try:os.startfile(folder)
            except Exception as exc:messagebox.showerror('Папка',str(exc),parent=w)

        def render():
            clear();i=step['i'];step_label.config(text=f'Шаг {i+1} из {len(titles)} — {titles[i]}')
            back.config(state='normal' if i>0 else 'disabled');nextb.config(text='Готово' if i==len(titles)-1 else 'Далее →')
            if i==0:
                desc.config(text='Сначала нужен объект для резки или рисования.')
                if self.project.objects:note(f'✓ Загружено объектов: {len(self.project.objects)}','ok')
                else:note('Файл ещё не загружен. Нажмите «Импорт» в главном окне или кнопку ниже.','bad')
                ttk.Button(body,text='Импортировать файл…',command=self.do_import).pack(anchor='w',pady=10)
                note('Для растровой картинки выбирайте «Нет» на вопрос про осевые линии, если нужно вырезать контур или полностью закрашивать фигуру.')
            elif i==1:
                desc.config(text='Разместите объект на столе. Теперь его можно хватать левой кнопкой мыши прямо в главном координатном поле и перетаскивать.')
                ok,msg=self._placement_ok();note(('✓ ' if ok else '⚠ ')+msg,'ok' if ok else 'warn')
                note('Окно мастера не блокирует главное окно: потяните объект мышкой. Зелёная пунктирная рамка показывает выбранный объект. Точные X/Y остаются слева.')
                ttk.Button(body,text='Поставить выбранный объект по центру',command=center_selected).pack(anchor='w',pady=8)
                ttk.Button(body,text='Обновить проверку размещения',command=render).pack(anchor='w')
            elif i==2:
                desc.config(text='Выберите, что делает инструмент. Для ножа нужна «Резка» — только границы. Для ручки/маркера «Рисование» может обводить и закрашивать всю площадь.')
                grid=ttk.Frame(body);grid.pack(fill='x',anchor='n')
                ttk.Label(grid,text='Профиль материала / инструмента').grid(row=0,column=0,sticky='w',pady=4);cb=ttk.Combobox(grid,textvariable=wmat,values=[x.name for x in DEFAULT_MATERIALS],state='readonly',width=34);cb.grid(row=0,column=1,sticky='ew',pady=4);cb.bind('<<ComboboxSelected>>',load_material)
                ttk.Label(grid,text='Операция').grid(row=1,column=0,sticky='w',pady=4);ttk.Combobox(grid,textvariable=wm,values=['Резка','Рисование'],state='readonly').grid(row=1,column=1,sticky='ew',pady=4)
                ttk.Label(grid,text='Рабочая скорость, мм/с').grid(row=2,column=0,sticky='w',pady=4);ttk.Entry(grid,textvariable=wspeed).grid(row=2,column=1,sticky='ew',pady=4)
