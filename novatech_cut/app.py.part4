                    ok,msg=self._placement_ok()
                    if not ok:messagebox.showwarning('Размещение','Объект выходит за безопасную область. Перетащите его на поле или используйте кнопку центрирования.',parent=w);return
                if i==2:
                    try:apply_settings()
                    except Exception as exc:messagebox.showerror('Параметры',str(exc),parent=w);return
                if i==3 and not self.project.printer.calibrated:messagebox.showwarning('Калибровка','Сначала завершите калибровку профиля A1 + UMTS.',parent=w);return
                if i==4 and not self._air_test_exported:messagebox.showwarning('Воздушный тест','Сначала сохраните и проверьте воздушный тест.',parent=w);return
                if i==len(titles)-1:w.destroy();return
            step['i']=max(0,min(len(titles)-1,i+delta));render()
        back.config(command=lambda:go(-1));nextb.config(command=lambda:go(1))
        def closed():self._wizard=None;w.destroy()
        w.protocol('WM_DELETE_WINDOW',closed);render()

    def calibrate(self):
        w=tk.Toplevel(self);w.title('Мастер калибровки A1 + UMTS')
        screen_h=max(560,self.winfo_screenheight());screen_w=max(760,self.winfo_screenwidth())
        width=min(800,max(640,int(screen_w*0.68)));height=min(620,max(480,int(screen_h*0.72)))
        w.geometry(f'{width}x{height}+20+20');w.minsize(600,450);w.transient(self);w.grab_set()

        vx=tk.DoubleVar(value=self.project.printer.tool_offset_x)
        vy=tk.DoubleVar(value=self.project.printer.tool_offset_y)
        vw=tk.DoubleVar(value=self.project.printer.work_z)
        vs=tk.DoubleVar(value=self.project.printer.safe_z)
        ok=tk.BooleanVar(master=w,value=False)

        def apply():
            if not ok.get():
                messagebox.showwarning('Калибровка','Поставьте галочку подтверждения: значения должны быть измерены на вашем модуле.',parent=w);return
            try:
                safe_z=float(vs.get());work_z=float(vw.get())
                if safe_z<=work_z:
                    if not messagebox.askyesno('Проверка Z','Безопасная Z не выше рабочей Z. Вы уверены, что для вашей механики это правильно?',parent=w):
                        return
                p=self.project.printer
                p.tool_offset_x=float(vx.get());p.tool_offset_y=float(vy.get())
                p.work_z=work_z;p.safe_z=safe_z;p.calibrated=True
                self.project.material.work_z=p.work_z;self.project.material.safe_z=p.safe_z
                self._air_test_exported=False
                w.destroy();self.refresh_all()
            except Exception as exc:
                messagebox.showerror('Калибровка',str(exc),parent=w)

        # Top action bar is intentionally first and always visible, even if
        # Windows DPI scaling clips the lower edge of the window.
        toolbar=ttk.Frame(w,padding=(10,8));toolbar.pack(side='top',fill='x')
        ttk.Label(toolbar,text='Калибровка A1 + UMTS',style='Title.TLabel').pack(side='left')
        ttk.Button(toolbar,text='Отмена',command=w.destroy).pack(side='right')
        ttk.Button(toolbar,text='Сохранить калибровку',style='Danger.TButton',command=apply).pack(side='right',padx=(0,8))

        values=ttk.LabelFrame(w,text='Измеренные значения',padding=10)
        values.pack(side='bottom',fill='x',padx=10,pady=(4,4))
        values.grid_columnconfigure(1,weight=1)
        for row,(lab,var) in enumerate([('Offset X, мм',vx),('Offset Y, мм',vy),('Рабочая Z',vw),('Безопасная Z',vs)]):
            ttk.Label(values,text=lab).grid(row=row,column=0,sticky='w',padx=(0,10),pady=3)
            ttk.Entry(values,textvariable=var).grid(row=row,column=1,sticky='ew',pady=3)

        confirm=ttk.Frame(w,padding=(10,0,10,4));confirm.pack(side='bottom',fill='x')
        ttk.Checkbutton(
            confirm,
            text='Я физически измерил X/Y/Z и понимаю риск неверной рабочей Z',
            variable=ok
        ).pack(side='left',anchor='w')

        body=ttk.Frame(w,padding=(10,4,10,4));body.pack(side='top',fill='both',expand=True)
        body.grid_columnconfigure(0,weight=1);body.grid_rowconfigure(0,weight=1)
        txt=tk.Text(body,wrap='word',font=('Segoe UI',10),height=8)
        sb=ttk.Scrollbar(body,orient='vertical',command=txt.yview);txt.configure(yscrollcommand=sb.set)
        txt.grid(row=0,column=0,sticky='nsew');sb.grid(row=0,column=1,sticky='ns')
        txt.insert('1.0','''Мастер калибровки Novatech Cut

1. Снимите UMTS. Любой homing выполняется только без режущего модуля.
2. Выполните штатный homing на принтере.
3. Закрепите материал/коврик.
4. После остановки головки установите UMTS.
5. Измерьте смещение X/Y кончика ножа или ручки относительно сопла.
6. Найдите безопасную Z — инструмент гарантированно не касается материала.
7. Найдите рабочую Z маленькими шагами на ненужном материале.
8. Введите значения ниже, поставьте галочку и нажмите «Сохранить калибровку» ВВЕРХУ окна.

Offset X/Y — реальное смещение инструмента от сопла.
Рабочая Z — высота контакта инструмента с материалом.
Безопасная Z — высота холостого перемещения без касания.

Горячие клавиши:
Ctrl+Enter — сохранить калибровку
Esc — отмена

Не копируйте чужие значения Z: они зависят от конкретного UMTS, установки инструмента, материала и коврика.
''');txt.config(state='disabled')

        w.bind('<Escape>',lambda e:w.destroy())
        w.bind('<Control-Return>',lambda e:apply())
    def export(self,air=False,show_message=True):
        try:
            self.sync_material();paths=prepare_paths(self.project.objects,self.project.material)
            if not paths:raise GCodeError('Нет траекторий для экспорта')
            g,stats=generate_gcode(paths,self.project.printer,self.project.material,air_test=air)
            ext='.airtest.gcode.3mf' if air else '.gcode.3mf';f=filedialog.asksaveasfilename(defaultextension=ext,filetypes=[('Bambu G-code 3MF','*.gcode.3mf'),('G-code','*.gcode')])
            if not f:return None
            if f.lower().endswith('.3mf'):build_gcode_3mf(f,g,stats,self.project.printer.name)
            else:Path(f).write_text(g,encoding='utf-8')
            report=Path(f+'.report.json');report.write_text(json.dumps({'air_test':air,'material':self.project.material.to_dict(),'printer':self.project.printer.to_dict(),'cut_length_mm':stats.cut_length_mm,'travel_length_mm':stats.travel_length_mm,'estimated_seconds':stats.estimated_seconds,'bounds':stats.bounds,'passes':stats.passes},ensure_ascii=False,indent=2),encoding='utf-8')
            self.last_export_path=f
            if air:self._air_test_exported=True
            if show_message:
                kind='воздушный тест' if air else 'задание'
                messagebox.showinfo('Экспорт',f'Готово: {kind}.\n{f}\n\nФайл не отправляется на принтер автоматически — дальнейшие шаги есть в «Мастере подготовки и запуска».')
            return f
        except Exception as e:
            messagebox.showerror('Экспорт заблокирован',str(e));return None

def calibration_gui_self_test():
    """Create the calibration dialog and verify its critical controls exist."""
    app=App()
    app.withdraw()
    try:
        app.calibrate()
        app.update_idletasks()
        tops=[w for w in app.winfo_children() if isinstance(w,tk.Toplevel)]
        if not tops:
            raise RuntimeError('Calibration dialog was not created')
        win=tops[-1]
        texts=[]
        entries=[]
        checks=[]
        def walk(widget):
            for child in widget.winfo_children():
                try:
                    if isinstance(child,(ttk.Button,ttk.Label,ttk.Checkbutton)):
                        texts.append(str(child.cget('text')))
                    if isinstance(child,ttk.Entry): entries.append(child)
                    if isinstance(child,ttk.Checkbutton): checks.append(child)
                except Exception:
                    pass
                walk(child)
        walk(win)
        if 'Сохранить калибровку' not in texts:
            raise RuntimeError('Save calibration button is missing')
        if 'Отмена' not in texts:
            raise RuntimeError('Cancel button is missing')
        if len(entries)<4:
            raise RuntimeError(f'Expected at least 4 calibration entries, got {len(entries)}')
        if not checks:
            raise RuntimeError('Calibration confirmation checkbox is missing')
        win.destroy()
        app.update_idletasks()
        return True
    finally:
        try: app.destroy()
        except Exception: pass


def main():
    App().mainloop()
if __name__=='__main__':main()
